VITE_API_BASE_URL=http://localhost:8080/api

# OCR 설정(OCR_PROVIDER, GEMINI_API_KEY, OLLAMA_HOST 등)은 server/.env 로 옮겼다.
# VITE_ 로 시작하는 값은 빌드된 번들에 그대로 들어가므로 비밀 키를 두면 안 된다.

# 프론트는 castVote 전송에만 RPC 사용 → 키 없는 공개 RPC 권장 (Alchemy 키 노출 방지).
# 레이트리밋 시 https://1rpc.io/sepolia · https://sepolia.drpc.org 로 교체 가능.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
