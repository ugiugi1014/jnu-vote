PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=vote_user
DB_PASSWORD=vote1234
DB_NAME=jnu_vote

# 이메일 발송 (Gmail SMTP)
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_app_password

# JWT
JWT_SECRET=your_jwt_secret

# 관리자 이메일 화이트리스트 (쉼표 구분, 공백 허용)
# 여기 등록된 이메일은 도메인 검사(@stu.jejunu.ac.kr)를 우회하고 admin role을 부여받음
ADMIN_EMAILS=jnuvote2026@gmail.com

# CORS 허용 origin (쉼표 구분, 미지정 시 Vite 기본 http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 블록체인 ───────────────────────────────
# 이더리움 RPC 엔드포인트 (Sepolia 등)
RPC_URL=https://sepolia.infura.io/v3/your_project_id

# 컨트랙트 호출용 관리자 지갑 개인키 (issueTokenBatch, recordTally 등)
# ※ 흐름도의 "코디네이터 ECDH 키"와는 별개. ECDH 키는 elections.coord_private_key (DB) 에 자동 저장됨.
ADMIN_WALLET_PRIVATE_KEY=0x...

# ── ZKP (tally.circom) ─────────────────────
# 회로 사이즈 — 회로 빌드 시 정한 값과 일치해야 함
TALLY_CIRCUIT_VOTES=10
TALLY_CIRCUIT_CANDIDATES=3
# 회로 빌드 산출물 경로 (기본: server/zkp/build/...)
# ZKP_BUILD_DIR=
# TALLY_WASM_PATH=
# TALLY_WITNESS_GEN_PATH=
# TALLY_ZKEY_PATH=
# Padding (실제 투표 < 회로 사이즈일 때 dummy 채우는 값)
# TALLY_PAD_SHAREDKEY=0
# TALLY_PAD_NONCE=0
# TALLY_PAD_CIPHERTEXT=0
