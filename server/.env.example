PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=vote_user
DB_PASSWORD=vote1234
DB_NAME=jnu_vote

# 이메일 발송 (Gmail SMTP)
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_app_password

# JWT
JWT_SECRET=your_jwt_secret

# 관리자 이메일 화이트리스트 (쉼표 구분, 공백 허용)
# 여기 등록된 이메일은 도메인 검사(@stu.jejunu.ac.kr)를 우회하고 admin role을 부여받음
ADMIN_EMAILS=jnuvote2026@gmail.com

# ── 재학증명서 OCR (프론트가 아니라 서버에서 호출) ──
OCR_PROVIDER=ollama            # ollama 또는 gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=https://your-ollama-host
OLLAMA_MODEL=qwen2.5vl:7b-q8_0

# ── 코디네이터 개인키 저장 암호화 (32바이트, 64자리 hex) ──
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ※ 잃으면 진행 중인 선거를 개표할 수 없으므로 따로 백업
COORD_KEY_ENCRYPTION_KEY=

# ── 요청 횟수 제한 ──
RELAY_RATE_WINDOW_MS=60000      # /vote/relay: IP 당 창 길이
RELAY_RATE_MAX=10               # /vote/relay: 창당 최대 요청 수
OCR_RATE_MAX=20                 # /verification/ocr: 사용자당 10분 최대 요청 수
# 프록시 뒤에서 실행할 때 (예: 1)
TRUST_PROXY=

# CORS 허용 origin (쉼표 구분, 미지정 시 Vite 기본 http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 블록체인 ───────────────────────────────
# 이더리움 RPC 엔드포인트 (Sepolia 등)
RPC_URL=https://sepolia.infura.io/v3/your_project_id

# 컨트랙트 호출용 관리자 지갑 개인키 (registerVoter, relay castVote, recordTallyBatch 등)
# ※ 흐름도의 "코디네이터 ECDH 키"와는 별개. ECDH 키는 elections.coord_private_key (DB) 에 자동 저장됨.
ADMIN_WALLET_PRIVATE_KEY=0x...

#선거별 컨트랙트 발행용 ElectionFactory의 주소
# ElectionFactory must be deployed with VotingSystem impl, VotingToken impl, vote verifier, and tally verifier.
FACTORY_ADDRESS=0x...

# ── ZKP (tally.circom) ─────────────────────
# 회로 사이즈 — 회로 빌드 시 정한 값과 일치해야 함
TALLY_CIRCUIT_VOTES=50          # 배치 1개당 표 수 (tally.circom Tally(50,5))
TALLY_CIRCUIT_CANDIDATES=5
# 회로 빌드 산출물 경로 (기본: ../zkp/build, ../zkp/keys)
# ZKP_BUILD_DIR=../zkp/build
# TALLY_WASM_PATH=../zkp/build/tally.wasm
# TALLY_WITNESS_GEN_PATH=../zkp/build/generate_witness.js
# TALLY_ZKEY_PATH=../zkp/keys/tally_final.zkey
# Padding (실제 투표 < 회로 사이즈일 때 dummy 채우는 값)
# TALLY_PAD_SHAREDKEY=0
# TALLY_PAD_NONCE=0
# TALLY_PAD_CIPHERTEXT=999
